# ============================================================
#  Get It Sasta Pay — environment variables (store se ALAG app)
#  Hostinger: hPanel → Websites → (pay wali Node.js app) → Environment variables
# ============================================================
NODE_ENV=production
# Is app ka apna address (subdomain), payment links isi se bante hain
PUBLIC_URL=https://pay.getitsasta.com
ADMIN_USERNAME=admin
# Pehli baar start par isi se Pay panel ka admin banega (8+ characters). Store wala password mat use karo.
ADMIN_PASSWORD=change-this-strong-password

# Baaki sab (Binance Pay, wallet addresses, provider API keys, stores) Pay panel se set hota hai — yahan nahi.

# ---- Advanced (normally khaali) ----
# DATA_DIR=            # Hostinger par apne aap ~/domains/<domain>/pay-data
# PORT=3100            # Hostinger khud deta hai
# RECHECK_MS=15000     # confirm ho rahe transactions kitni der mein dobara check
# ADMIN_RESET_PASSWORD=   # password bhool gaye? yahan naya daalo, redeploy, login, phir hata do
