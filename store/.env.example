# ============================================================
#  Get It Sasta — environment variables
#  Hostinger: hPanel → Websites → (Node.js app) → Environment variables mein ek-ek daalo
#  VPS: is file ko .env naam se copy karo
# ============================================================

# ---- Zaroori ----
NODE_ENV=production
PUBLIC_URL=https://getitsasta.com
ADMIN_USERNAME=admin
# Pehli baar start par isi password se admin banega (8+ characters). Baad mein admin panel se badlo.
ADMIN_PASSWORD=change-this-strong-password

# ---- Crypto: Get It Sasta Pay (alag app, jaise https://pay.getitsasta.com) ----
# Pay panel → Stores (API) → "Store banao" se API key + webhook secret milte hain.
# Webhook URL jo Pay panel mein daalna hai: https://getitsasta.com/api/pay/webhook
PAY_URL=
PAY_API_KEY=
PAY_WEBHOOK_SECRET=

# ---- Emails + OTP login: Resend (resend.com → API Keys) ----
# Pehle Resend mein getitsasta.com domain verify karo (DNS records), phir:
RESEND_API_KEY=
MAIL_FROM=Get It Sasta <noreply@getitsasta.com>
# noreply se jaata hai; customer "Reply" kare to Settings wala support email milta hai.
# Admin login par 2-step OTP isi email par jayega
ADMIN_EMAIL=

# ---- (Resend ki jagah) SMTP, jaise Hostinger email — optional ----
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=support@getitsasta.com
# SMTP_PASS=

# ---- Optional: Telegram par naye order ka alert (Pay app se iska koi lena-dena nahi) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Advanced (normally khaali chhodo) ----
# DATA_DIR=          # database + photos ka folder. Hostinger par apne aap ~/domains/<domain>/gis-data
# PORT=3000          # Hostinger khud deta hai
# HOST=127.0.0.1     # VPS + Nginx ke liye
# TRUST_PROXY=1
# ADMIN_RESET_PASSWORD=   # admin password bhool gaye? yahan naya daalo, redeploy, login, phir hata do

# ---------- Live chat (website → Telegram) ----------
# Website chat pehle khud jawab deta hai; customer "Talk to a person" dabaye to message aapke Telegram par aata hai.
# Aap us message par Reply karo → jawab website chat mein. ALAG bot banao (BotFather → /newbot) — alert wala bot mat do.
# SUPPORT_CHAT_ID khaali ho to TELEGRAM_CHAT_ID use hoga. Token khaali = chat sirf bot + WhatsApp/email.
SUPPORT_BOT_TOKEN=
SUPPORT_CHAT_ID=
